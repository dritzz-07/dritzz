rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isAdmin() {
      return request.auth != null && request.auth.token != null && request.auth.token.email != null && (
        request.auth.token.email == 'dritzz.info@gmail.com' ||
        request.auth.token.email == 'Dritzz.info@gmail.com' ||
        request.auth.token.email == 'sujitsinghguw@gmail.com' ||
        request.auth.token.email == 'Sujitsinghguw@gmail.com' ||
        request.auth.token.email == 'admin@dritzz.info'
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if true;
    }

    match /subscriptions/{subId} {
      allow read, update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if true;
    }
  }
}

